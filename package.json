{
  "name": "kitobkhona-desktop",
  "version": "3.1.0",
  "description": "Китобхонаи электронӣ ва ёвари Алия барои Windows",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "test:aliya": "node tests/aliya-smoke.js",
    "test:ui": "node tests/ui-regression.js",
    "test:reader": "node tests/reader-paging.js",
    "test:latency": "node tests/aliya-latency.js",
    "test:gateway": "python3 tests/gateway_deadline.py",
    "test:html": "python3 tests/check_aliya_html.py",
    "test:fixes": "npm run test:aliya && npm run test:reader && npm run test:reader-aliya && npm run test:reader-zoom && npm run test:latency && npm run test:gateway && npm run test:html && npm run test:ui",
    "test:reader-aliya": "node tests/reader-aliya-tools.js && node tests/reader-aliya-export-runtime.js && node tests/reader-aliya-click.js",
    "test:reader-zoom": "node tests/reader-zoom-theme-runtime.js"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tj.kitobkhona.desktop",
    "productName": "Kitobkhona",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "**/*",
      "!.git/**",
      "!.github/**",
      "!tests/**",
      "!node_modules/**",
      "!dist/**",
      "!coverage/**",
      "!*.zip",
      "!*.md",
      "!*.log",
      "!package-lock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kitobkhona",
      "artifactName": "Kitobkhona-Setup.exe"
    }
  },
  "author": "Kitobkhona"
}
