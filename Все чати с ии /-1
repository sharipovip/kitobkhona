  }

  function formatHours(seconds) {
    if (!seconds || seconds < 0) return '0 соат';
    const h = Math.round(seconds / 3600);
    return h + ' соат';
  }

  function getAge(birthYear) {
    if (!birthYear) return null;
    if (String(birthYear).length === 4) return new Date().getFullYear() - Number(birthYear);
    return Number(birthYear);
  }

  function renderWinners(data) {
    if (!data || !data.length) {
      mainContent.innerHTML = `
        <div class="empty-state">
          <div class="icon">🏆</div>
          <h3>Ғолибон нестанд</h3>
          <p>Барои дидани ғолибон, китобҳо хонед!</p>
        </div>
        <div class="content-spacer"></div>
      `;
      return;
    }

    // Prepare filters
    const allRegions = [...new Set(data.map(item => item.region || '').filter(Boolean))];
    const allAges = [...new Set(data.map(item => getAge(item.birth_year)).filter(a => a !== null))].sort((a,b) => a-b);
    const ageRanges = [
      { label: 'Синну сол: ҳама', value: 'all' },
      ...allAges.length ? [
        { label: '7–12 сола', value: '7-12' },
