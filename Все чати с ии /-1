<body>
  <button class="theme-btn" id="themeToggle">🌙</button>

  <div class="profile-container">
    <div class="topbar">
      <h2>Профил</h2>
      <div class="icon-btn" id="openEdit">✏️</div>
    </div>

    <div id="profileContent">
      <div class="loading-spinner"><div class="spinner"></div> Боргирӣ...</div>
    </div>

    <div id="profileData" style="display:none;">
      <!-- профиль будет вставлен скриптом -->
    </div>
  </div>

  <!-- ===== EDIT SHEET ===== -->
  <div class="sheet-overlay" id="editOverlay">
    <div class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-head">
        <h3>Таҳрири профил</h3>
        <div class="icon-btn" id="closeEdit">✕</div>
      </div>
      <div class="sheet-body">
        <div class="field-row">
          <div class="field"><label>Ном</label><input type="text" id="editName" placeholder="Ном"></div>
          <div class="field"><label>Насаб</label><input type="text" id="editSurname" placeholder="Насаб"></div>
        </div>
        <div class="field"><label>Соли таваллуд</label><input type="number" id="editBirthYear" placeholder="2000"></div>
        <div class="field"><label>Вилоят</label>
          <select id="editRegion">
            <option value="">Интихоб кунед</option>
            <option value="Шаҳри Душанбе">Шаҳри Душанбе</option>
            <option value="Вилояти Суғд">Вилояти Суғд</option>
            <option value="Вилояти Хатлон">Вилояти Хатлон</option>
