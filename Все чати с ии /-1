          return `
            <div class="rank-item">
              <div class="rank">${index + 1}</div>
              <div class="user">
                <strong>${esc(item.display_name || item.full_name || 'Китобхон')}</strong>
                <span>${esc(item.city || item.region || 'Тоҷикистон')}</span>
              </div>
              <div class="hours">${formatHours(item.total_minutes || item.valid_seconds)}</div>
            </div>
          `;
        }).join('')}
      </div>
    `;
    html += '<div class="content-spacer"></div>';
    mainContent.innerHTML = html;

    // Filter functionality
    document.getElementById('ageFilter')?.addEventListener('change', () => filterList(data));
    document.getElementById('regionFilter')?.addEventListener('change', () => filterList(data));
  }

  function filterList(data) {
    const ageFilter = document.getElementById('ageFilter').value;
    const regionFilter = document.getElementById('regionFilter').value;

    let filtered = [...data];

    if (ageFilter !== 'all') {
      filtered = filtered.filter(item => {
        const age = getAge(item.birth_year);
        if (age === null) return false;
        if (ageFilter === '40+') return age > 40;
        const [min, max] = ageFilter.split('-').map(Number);
        return age >= min && age <= max;
      });
    }

    if (regionFilter !== 'all') {
      filtered = filtered.filter(item => (item.region || '').includes(regionFilter));
    }

    const rankList = document.getElementById('rankList');
    if (rankList) {
      if (filtered.length === 0) {
        rankList.innerHTML = '<div class="empty-state" style="padding:20px;">Бо ин филтрҳо натиҷае ёфт нашуд</div>';
        return;
      }
      rankList.innerHTML = filtered.map((item, index) => `
        <div class="rank-item">
          <div class="rank">${index + 1}</div>
          <div class="user">
            <strong>${esc(item.display_name || item.full_name || 'Китобхон')}</strong>
            <span>${esc(item.city || item.region || 'Тоҷикистон')}</span>
          </div>
          <div class="hours">${formatHours(item.total_minutes || item.valid_seconds)}</div>
        </div>
      `).join('');
    }
  }

  async function loadWinners() {
