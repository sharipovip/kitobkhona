    </div>

    <div class="scroll" id="feedScroll">
      <div class="loading-spinner"><div class="spinner"></div> Боргирӣ...</div>
    </div>

    <div class="bottom-nav">
      <div class="nav-item" onclick="location.href='index.html'"><span class="ic">🏠</span><span>Асосӣ</span></div>
      <div class="nav-item" onclick="location.href='kitobho.html'"><span class="ic">📚</span><span>Китобҳо</span></div>
      <div class="nav-item active" onclick="location.href='Lenta.html'"><span class="ic">📰</span><span>Лента</span></div>
      <div class="nav-item" onclick="location.href='profile.html'"><span class="ic">👤</span><span>Профил</span></div>
    </div>
  </div>

  <script>
    const $ = id => document.getElementById(id);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    // Theme toggle
    const themeBtn = document.getElementById('themeToggle');
    themeBtn.addEventListener('click', ()=>{
      const isDark = document.body.dataset.theme === 'dark';
      document.body.dataset.theme = isDark ? 'light' : 'dark';
      themeBtn.textContent = isDark ? '☀️' : '🌙';
    });
    if(localStorage.getItem('kk_theme') === 'light'){
      document.body.dataset.theme = 'light';
      themeBtn.textContent = '☀️';
    }

    let currentUser = null;

    async function loadFeed() {
      const scroll = document.getElementById('feedScroll');

      try {
        const { data } = await AUTH.getUser();
        currentUser = data.user;
        if(!currentUser) {
          scroll.innerHTML = `
            <div class="empty-feed">
              <h3>Лента холӣ аст</h3>
              <p>Барои дидани лента ворид шавед</p>
              <button class="btn btn-primary" onclick="location.href='login.html'">Ворид шудан</button>
            </div>
          `;
          return;
        }

        // Загружаем посты из таблицы posts
        // Сначала получаем друзей, чтобы фильтровать только друзей для visibility='friends'
        const friends = await ChatAPI.getFriends(currentUser.id).catch(() => []);
        const friendIds = friends.map(id => `'${id}'`).join(',');

        // Запрос к таблице posts через Supabase
        // Показываем публичные посты и посты друзей
        let posts = [];
        try {
          // Получаем все посты
          const allPosts = await apiGet('posts', {
            order: 'created_at.desc',
            limit: 50
          });
          // Фильтруем: публичные или друзья
          const filtered = allPosts.filter(p => {
            if(p.visibility === 'public') return true;
            if(p.visibility === 'friends' && friends.includes(p.user_id)) return true;
            return false;
          });
          posts = filtered;
        } catch(e) {
          console.warn('Posts load error', e);
        }

        // Если постов нет — показываем пустое состояние
        if(!posts || posts.length === 0) {
          scroll.innerHTML = `
            <div class="empty-feed">
              <h3>Лента холӣ аст</h3>
              <p>Вақте ки шумо ё дӯстонатон дар бораи китобе нависанд, он дар ин ҷо намоён мешавад.</p>
              <button class="btn btn-outline" onclick="location.href='kitobho.html'">Китобҳоро дидан</button>
            </div>
          `;
          return;
        }

        // Получаем профили пользователей для постов
        const userIds = [...new Set(posts.map(p => p.user_id))];
        const profiles = {};
        await Promise.all(userIds.map(async (id) => {
          try {
            const p = await AUTH.getProfileFromRailway(id);
            if(p) profiles[id] = p;
          } catch(e) {}
        }));

        // Загружаем лайки и комментарии (для каждого поста)
        // Для простоты пока используем счётчики из таблицы posts
        // Но можно сделать отдельные запросы для подсчёта

        // Формируем HTML
        const colors = ['c1','c2','c3','c4','c5','c6','c7','c8','c9'];
        let html = '';

        // Stories (демо)
        html += `
          <div class="stories-rail">
            <div class="story-item" onclick="location.href='kitobho.html'">
              <div class="story-ring add"><div class="story-inner">+</div></div>
              <div class="story-name">Нав</div>
            </div>
          </div>
        `;

        // Посты
        html += `<div class="feed">`;
        for(const post of posts) {
          const profile = profiles[post.user_id] || {};
          const displayName = profile.display_name || profile.full_name || 'Китобхон';
          const avatarEmoji = profile.avatar_emoji || '👤';
          const timeAgo = formatTime(post.created_at);
          const bookTitle = post.book_title || 'Китоб';
          const bookAuthor = post.book_author || '';
          const bookUrl = post.book_url || '';
          const bookCover = post.book_cover || '';
          const status = post.status || 'reading';
          const progress = post.progress || 0;
          const likes = post.likes_count || 0;
          const comments = post.comments_count || 0;
          const content = post.content || '';

          html += `
            <div class="post-card ${status === 'achievement' ? 'achieve' : ''}">
              <div class="post-head">
                <div class="av"><div class="av-inner">${esc(avatarEmoji)}</div></div>
                <div class="post-head-text">
                  <div class="post-name">${esc(displayName)}</div>
                  <div class="post-time">${timeAgo}</div>
                </div>
              </div>
              ${content ? `<div class="post-caption">${esc(content)}</div>` : ''}
              <div class="book-block" onclick="openBook('${encodeURIComponent(bookUrl)}','${encodeURIComponent(bookTitle)}')">
                <div class="thumb">
                  ${bookCover ? `<img src="${esc(bookCover)}" alt="${esc(bookTitle)}">` : `<div class="fallback">📖</div>`}
                </div>
                <div class="book-info">
                  <div class="book-title">${esc(bookTitle)}</div>
                  ${bookAuthor ? `<div class="book-author">${esc(bookAuthor)}</div>` : ''}
                  <div class="status-chip ${status === 'finished' ? 'chip-finished' : status === 'achievement' ? 'chip-achieve' : 'chip-reading'}">
                    ${status === 'finished' ? '✅ Хатм кард' : status === 'achievement' ? '🏆 Дастовард' : '📖 Дар ҳоли хондан'}
                  </div>
                  ${progress > 0 ? `<div class="progress-track"><div class="progress-fill" style="width:${Math.min(progress,100)}%"></div></div>` : ''}
                </div>
              </div>
              <div class="post-actions">
                <div class="action-group">
                  <div class="action-btn" onclick="toggleLike(this, '${post.id}')">
                    <span class="ic">♡</span><span class="cnt">${likes}</span>
                  </div>
                  <div class="action-btn" onclick="toggleComments(this, '${post.id}')">
                    <span class="ic">💬</span><span>${comments}</span>
                  </div>
                  <div class="action-btn" onclick="sharePost('${encodeURIComponent(bookUrl)}','${encodeURIComponent(bookTitle)}')">
                    <span class="ic">↗</span>
                  </div>
                </div>
                <div class="save-btn" onclick="toggleSave(this, '${post.id}')">🔖</div>
              </div>
              <div class="post-comments" id="comments-${post.id}">
                <!-- комментарии будут загружены отдельно -->
                <div class="view-comments" onclick="loadComments('${post.id}')">Дидани шарҳҳо</div>
                <div class="comment-input-row">
                  <div class="av"><div class="av-inner">${esc(avatarEmoji)}</div></div>
                  <input class="comment-input" type="text" id="commentInput-${post.id}" placeholder="Шарҳ нависед...">
