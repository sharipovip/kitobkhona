// ========== АВТО-ЛОГИН ==========
const AutoLogin = {
  async autoLogin() {
    let userId = localStorage.getItem('kk_user_id');
    let token = localStorage.getItem('kk_token');
    let username = localStorage.getItem('kk_username');

    // Если есть сохранённые данные — пробуем получить профиль
    if (userId && token) {
      try {
        const profile = await NEON_API.getProfile(userId, token);
        if (profile) {
          return { userId, token, profile, username };
        }
      } catch (e) {
        // Токен невалиден — удаляем и создаём нового
        localStorage.removeItem('kk_user_id');
        localStorage.removeItem('kk_token');
        localStorage.removeItem('kk_username');
      }
    }

    // Создаём нового пользователя
    return this.createNewUser();
  },

  async createNewUser() {
    let number = parseInt(localStorage.getItem('kk_user_number') || '0') + 1;
    const username = `kitobxona${number}`;
    const email = `${username}@kitobkhona.local`;
    const password = 'auto123456';

    try {
      const result = await NEON_API.registerUser({
        email: email,
        username: username,
        password: password,
        display_name: username,
        age: null,
        region: null,
        gender: null
      });

      if (result.userId && result.token) {
        localStorage.setItem('kk_user_id', result.userId);
        localStorage.setItem('kk_token', result.token);
        localStorage.setItem('kk_username', username);
        localStorage.setItem('kk_user_number', String(number));
        // Синхронизация с Supabase
        await this.syncProfileToSupabase(result.userId, username);
        return { userId: result.userId, token: result.token, profile: null, username };
      }
    } catch (e) {
      console.error('Auto-login failed:', e);
    }
    return null;
  },

  async syncProfileToSupabase(userId, username) {
    try {
      const existing = await apiGet('profiles', { eq: { column: 'server_user_id', value: userId } });
      if (existing && existing.length) return;
      await apiPost('profiles', {
        server_user_id: userId,
        username: username,
        display_name: username,
        full_name: username,
        avatar_emoji: '👤',
        is_complete: false,
        auto_created: true
      });
    } catch (e) {
      console.warn('Supabase sync failed:', e);
    }
  }
};

// ========== SUPABASE API ==========
async function apiGet(table, options = {}) {
  const { select = '*', eq, order, limit, single = false } = options;
  let url = `${KITOB_CONFIG.SUPABASE_REST}/${table}?select=${encodeURIComponent(select)}`;
  if (eq) url += `&${encodeURIComponent(eq.column)}=eq.${encodeURIComponent(eq.value)}`;
  if (order) url += `&order=${encodeURIComponent(order)}`;
  if (limit) url += `&limit=${limit}`;
  if (single) url += `&limit=1`;

  const token = localStorage.getItem('kk_token') || '';
  const res = await fetch(url, {
    headers: {
      'apikey': KITOB_CONFIG.SUPABASE_KEY,
      'Authorization': token ? `Bearer ${token}` : `Bearer ${KITOB_CONFIG.SUPABASE_KEY}`,
      'Content-Type': 'application/json'
    }
  });
  if (!res.ok) throw new Error(`API error ${res.status}`);
  return single ? (await res.json())[0] || null : await res.json();
}

async function apiPost(table, data) {
  const token = localStorage.getItem('kk_token') || '';
  const res = await fetch(`${KITOB_CONFIG.SUPABASE_REST}/${table}`, {
    method: 'POST',
    headers: {
      'apikey': KITOB_CONFIG.SUPABASE_KEY,
      'Authorization': token ? `Bearer ${token}` : `Bearer ${KITOB_CONFIG.SUPABASE_KEY}`,
      'Content-Type': 'application/json',
      'Prefer': 'return=representation'
    },
    body: JSON.stringify(data)
  });
  if (!res.ok) throw new Error(`API error ${res.status}`);
  return await res.json();
}

async function apiPatch(table, column, value, data) {
  const token = localStorage.getItem('kk_token') || '';
  const res = await fetch(`${KITOB_CONFIG.SUPABASE_REST}/${table}?${encodeURIComponent(column)}=eq.${encodeURIComponent(value)}`, {
    method: 'PATCH',
    headers: {
      'apikey': KITOB_CONFIG.SUPABASE_KEY,
      'Authorization': token ? `Bearer ${token}` : `Bearer ${KITOB_CONFIG.SUPABASE_KEY}`,
      'Content-Type': 'application/json',
      'Prefer': 'return=representation'
    },
    body: JSON.stringify(data)
  });
  if (!res.ok) throw new Error(`API error ${res.status}`);
  return await res.json();
}

function esc(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

