        </select>
      </div>
    `;

    // Podium (top 3)
    const top3 = data.slice(0, 3);
    const medals = ['🥈', '👑', '🥉'];
    html += `<div class="podium">`;
    top3.forEach((item, index) => {
      const age = getAge(item.birth_year);
      html += `
        <div class="podium-item ${index === 1 ? 'gold' : ''}">
