      const date = new Date(dateStr);
      const now = new Date();
      const diff = Math.floor((now - date) / 1000);
      if(diff < 60) return 'ҳозир';
      if(diff < 3600) return Math.floor(diff/60) + ' дақ';
      if(diff < 86400) return Math.floor(diff/3600) + ' соат';
      if(diff < 604800) return Math.floor(diff/86400) + ' рӯз';
      return date.toLocaleDateString('tg');
