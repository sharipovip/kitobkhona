        <div class="field-row">
          <div class="field"><label>Шаҳр/ноҳия</label><input type="text" id="editCity" placeholder="Шаҳр"></div>
          <div class="field"><label>Ҷамоат</label><input type="text" id="editJamoat" placeholder="Ҷамоат"></div>
        </div>
