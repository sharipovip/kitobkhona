        </div>
      `;

      // Загружаем книги из books.json (как пример)
      try {
        const booksResp = await fetch(KITOB_CONFIG.GITHUB_BOOKS_URL);
        if (booksResp.ok) {
          const data = await booksResp.json();
          const categories = data.categories || [];
          const grid = document.getElementById('booksGrid');
          let books = [];
          for (const cat of categories.slice(0, 3)) {
            for (const sub of (cat.subs || []).slice(0, 1)) {
              try {
                const manResp = await fetch(`https://raw.githubusercontent.com/${KITOB_CONFIG.GITHUB_REPO}/${KITOB_CONFIG.GITHUB_BRANCH}/${sub.folder}/manifest.json`);
                if (manResp.ok) {
                  const man = await manResp.json();
                  if (man.books) books.push(...man.books.slice(0, 3));
                }
              } catch(e) {}
            }
          }
          if (books.length) {
            grid.innerHTML = books.slice(0, 6).map(b => `
              <div class="book-item" onclick="location.href='reader.html?url=${encodeURIComponent(b.file || '')}&name=${encodeURIComponent(b.name || 'Китоб')}'">
                <div class="cover">📖</div>
                <div class="title">${escapeHtml(b.name || 'Китоб')}</div>
                <div class="author">${escapeHtml(b.author || '')}</div>
              </div>
            `).join('');
          } else {
            grid.innerHTML = `<div style="grid-column:1/-1;color:#8CA0B8;text-align:center;">Китобҳо дастрас нестанд</div>`;
          }
        }
      } catch(e) {
        console.warn('Books load error:', e);
      }

    } catch (e) {
      console.error('Fatal error:', e);
      main.innerHTML = `
        <div class="error-box">
          <p>Хатогӣ: ${escapeHtml(e.message)}</p>
          <button style="margin-top:12px;padding:8px 16px;background:#DCB55E;color:#1A1206;border:none;border-radius:8px;cursor:pointer;" onclick="location.reload()">Боз кӯшидан</button>
        </div>
      `;
    }
  })();

  function escapeHtml(s) {
    if (!s) return '';
    return String(s).replace(/[&<>"']/g, function(m) {
      if (m === '&') return '&amp;';
      if (m === '<') return '&lt;';
      if (m === '>') return '&gt;';
      if (m === '"') return '&quot;';
      if (m === "'") return '&#39;';
      return m;
    });
  }
