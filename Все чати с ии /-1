  <script>
    const $ = id => document.getElementById(id);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const profileContent = $('profileContent');
    const profileData = $('profileData');
    let currentUser = null;
    let viewingUserId = null;
    let currentProfile = null;

    // Theme
    const themeBtn = $('themeToggle');
    themeBtn.addEventListener('click', ()=>{
      const isDark = document.body.dataset.theme === 'dark';
      document.body.dataset.theme = isDark ? 'light' : 'dark';
      themeBtn.textContent = isDark ? '☀️' : '🌙';
      localStorage.setItem('kk_theme', isDark ? 'light' : 'dark');
    });
    if (localStorage.getItem('kk_theme') === 'light') {
      document.body.dataset.theme = 'light';
      themeBtn.textContent = '☀️';
    }

    // ---- Tabs ----
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.tab-btn');
      if (!btn) return;
      const parent = btn.closest('.tabs');
      if (!parent) return;
      parent.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.tab;
      const container = parent.closest('.tab-panel-container') || document;
      container.querySelectorAll('.tab-panel').forEach(p => {
        p.hidden = p.dataset.panel !== tab;
      });
    });

    // ---- Edit sheet ----
    const overlay = $('editOverlay');
    const openSheet = () => overlay.classList.add('open');
    const closeSheet = () => overlay.classList.remove('open');
    $('openEdit').addEventListener('click', openSheet);
    $('closeEdit').addEventListener('click', closeSheet);
    $('cancelEdit').addEventListener('click', closeSheet);
    overlay.addEventListener('click', (e)=>{ if(e.target === overlay) closeSheet(); });

    // ---- Render profile ----
    function renderProfile(profile, isOwn) {
      const userId = profile.user_id || viewingUserId || currentUser?.id;
      if (!profile) {
        profileData.innerHTML = `<div class="empty-state">Профил ёфт нашуд</div>`;
        return;
      }

      const name = profile.display_name || profile.full_name || 'Китобхон';
      const location = [profile.city, profile.region].filter(Boolean).join(', ') || '—';
      const avatarEmoji = profile.avatar_emoji || '👤';
      const books = profile.books_count || 0;
      const friends = profile.followers_count || 0;
      const favorites = profile.favorites_count || 0;

      let html = `
        <div class="profile-card">
          <div class="profile-row">
            <div class="avatar-ring"><div class="avatar-inner">${esc(avatarEmoji)}</div></div>
            <div class="stats-row">
              <div class="stat"><b>${books}</b><span>китобҳо</span></div>
              <div class="stat-divider"></div>
              <div class="stat"><b>${friends}</b><span>дӯстон</span></div>
              <div class="stat-divider"></div>
              <div class="stat"><b>${favorites}</b><span>хатбаракҳо</span></div>
            </div>
          </div>
          <div class="profile-meta">
            <h3>${esc(name)}</h3>
            <div class="status-chip">Китобхон 📚</div>
            <div class="meta-loc">${esc(location)}</div>
          </div>
        </div>
        <div class="action-row">
          ${isOwn ? `<button class="btn btn-ghost" onclick="location.href='chats.html'">Чатҳо</button>
                      <button class="btn btn-outline" id="openEdit2">Таҳрири профил</button>` :
                      `<button class="btn btn-primary" id="friendBtn" onclick="sendFriendRequest('${userId}')">Дархости дӯстӣ равон кардан</button>`}
        </div>
        <div class="tabs tab-panel-container">
          <div class="tab-btn active" data-tab="books">📚 Китобҳо</div>
          <div class="tab-btn" data-tab="marks">🔖 Хатбаракҳо</div>
          <div class="tab-btn" data-tab="ach">🏆 Дастовардҳо</div>
        </div>
        <div class="tab-panel" data-panel="books" id="panelBooks"><div class="loading-spinner"><div class="spinner"></div> Боргирӣ...</div></div>
        <div class="tab-panel" data-panel="marks" hidden><div class="loading-spinner"><div class="spinner"></div> Боргирӣ...</div></div>
        <div class="tab-panel" data-panel="ach" hidden><div class="loading-spinner"><div class="spinner"></div> Боргирӣ...</div></div>
      `;
      profileData.innerHTML = html;
      profileData.style.display = 'block';
      profileContent.style.display = 'none';

      // Загружаем данные для вкладок
      loadTabsData(userId);

      // Обработчик для кнопки редактирования (если есть)
      const editBtn = document.getElementById('openEdit2');
      if (editBtn) editBtn.addEventListener('click', openSheet);
    }

    // ---- Загрузка данных для вкладок ----
    async function loadTabsData(userId) {
      try {
        // Книги (reading_sessions)
        const sessions = await apiGet('reading_sessions', { eq: { column: 'user_id', value: userId }, order: 'created_at.desc', limit: 9 });
        const panelBooks = document.getElementById('panelBooks');
        if (sessions && sessions.length) {
          const colors = ['c1','c2','c3','c4','c5','c6','c7','c8','c9'];
          panelBooks.innerHTML = `
            <div class="book-grid">
              ${sessions.map((s, i) => `
                <div class="book-cover ${colors[i % colors.length]}">
                  <div class="book-title">${esc(s.book_title || 'Китоб')}</div>
                  <div class="book-author">${esc(s.book_author || '')}</div>
                </div>
              `).join('')}
            </div>
          `;
        } else {
          panelBooks.innerHTML = '<div class="empty-state">Ҳоло китобе хонда нашудааст</div>';
        }

        // Хатбаракҳо (favorites)
        const favs = await apiGet('user_favorites', { eq: { column: 'user_id', value: userId }, limit: 9 });
        const panelMarks = document.getElementById('panelMarks');
        if (favs && favs.length) {
          panelMarks.innerHTML = `
            <div class="book-grid">
              ${favs.slice(0, 9).map((f, i) => `
                <div class="book-cover c${(i%9)+1}">
                  <div class="book-title">${esc(f.book_title || 'Китоб')}</div>
                  <div class="book-author">${esc(f.book_author || '')}</div>
                </div>
              `).join('')}
            </div>
          `;
        } else {
          panelMarks.innerHTML = '<div class="empty-state">Хатбарак нест</div>';
        }

        // Дастовардҳо (achievements)
        const ach = await apiGet('user_achievements', { eq: { column: 'user_id', value: userId } });
        const panelAch = document.getElementById('panelAch');
        if (ach && ach.length) {
          panelAch.innerHTML = `
            <div class="ach-list">
              ${ach.map(a => `
                <div class="ach-card">
                  <div class="ach-icon">${a.icon || '🏆'}</div>
                  <div class="ach-text"><b>${esc(a.name || 'Дастовард')}</b><span>${esc(a.description || '')}</span></div>
                </div>
              `).join('')}
            </div>
          `;
        } else {
          panelAch.innerHTML = '<div class="empty-state">Ҳоло дастоварде нест</div>';
        }
      } catch (e) {
        console.warn('Tabs data error:', e);
      }
    }

    // ---- Отправка запроса в друзья ----
    async function sendFriendRequest(userId) {
      try {
        const { data } = await AutoLogin.autoLogin();
        if (!data) return alert('Ворид шавед');
        await ChatAPI.sendFriendRequest(data.userId, userId);
        alert('Дархост фиристода шуд');
        document.getElementById('friendBtn').textContent = 'Дархост фиристода шуд ✓';
        document.getElementById('friendBtn').className = 'btn btn-ghost';
      } catch (e) {
        alert('Хатогӣ: ' + e.message);
      }
    }
    window.sendFriendRequest = sendFriendRequest;

    // ---- Сохранение профиля ----
    $('saveEdit').addEventListener('click', async () => {
      const firstName = $('editName').value.trim();
      const lastName = $('editSurname').value.trim();
      const birthYear = parseInt($('editBirthYear').value);
      const region = $('editRegion').value;
      const city = $('editCity').value.trim();
      const jamoat = $('editJamoat').value.trim();
      const village = $('editVillage').value.trim();

      if (!firstName || !lastName || !birthYear || !region) {
        alert('Лутфан ҳамаи майдонҳои асосиро пур кунед');
        return;
      }

      try {
        const token = localStorage.getItem('kk_token');
        const userId = localStorage.getItem('kk_user_id');
        if (!token || !userId) throw new Error('Ворид шавед');

        await NEON_API.updateProfile(userId, {
          first_name: firstName,
          last_name: lastName,
          birth_year: birthYear,
          region: region,
          city: city,
          jamoat: jamoat,
          village: village,
          display_name: firstName + ' ' + lastName
        });

        // Обновляем в Supabase
        const profiles = await apiGet('profiles', { eq: { column: 'server_user_id', value: userId } });
        if (profiles.length) {
          await apiPatch('profiles', 'id', profiles[0].id, {
            full_name: firstName + ' ' + lastName,
            birth_year: birthYear,
            region: region,
            city: city
          });
        }

        closeSheet();
        loadProfile();
      } catch (e) {
        alert('Хатогӣ: ' + e.message);
      }
    });

    // ---- Загрузка профиля ----
    async function loadProfile() {
      try {
        // Проверяем, есть ли пользователь в URL (чужой профиль)
        const params = new URLSearchParams(location.search);
        const userIdParam = params.get('user');

        // Авто-логин
        const result = await AutoLogin.autoLogin();
        if (!result) {
          profileContent.innerHTML = `
            <div class="guest-wrap">
              <div class="brand-name">Китобхона</div>
              <div class="brand-tag">Китобхонаи рақамии тоҷикӣ</div>
              <button class="btn btn-primary" onclick="location.href='login.html'">Ворид шудан</button>
              <button class="btn btn-outline" onclick="location.href='login.html'">Сохтани профил</button>
              <div class="info-note" style="font-size:12px; color:var(--muted);">Барои дидани профил ворид шавед</div>
            </div>
          `;
          return;
        }

        currentUser = result;
        viewingUserId = userIdParam || currentUser.userId;

        // Загружаем профиль
        const profile = await NEON_API.getProfile(viewingUserId, currentUser.token);
        currentProfile = profile;

        // Определяем, свой это профиль или чужой
        const isOwn = (viewingUserId === currentUser.userId);
        renderProfile(profile, isOwn);

        // Заполняем форму редактирования (если свой)
        if (isOwn) {
          $('editName').value = profile.first_name || '';
          $('editSurname').value = profile.last_name || '';
          $('editBirthYear').value = profile.birth_year || '';
          $('editRegion').value = profile.region || '';
          $('editCity').value = profile.city || '';
          $('editJamoat').value = profile.jamoat || '';
          $('editVillage').value = profile.village || '';
        }

      } catch (e) {
        console.error(e);
        profileContent.innerHTML = `
          <div class="empty-state">
            <p style="color:var(--red);">Хатогӣ: ${esc(e.message)}</p>
            <button class="btn btn-outline" onclick="loadProfile()" style="margin-top:12px;">Боз кӯшидан</button>
          </div>
        `;
      }
    }

    loadProfile();
  </script>
